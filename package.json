{
  "name": "capglow",
  "productName": "Capglow",
  "version": "0.1.1",
  "description": "Contrôle de l'éclairage RGB du clavier Evoworks EVO80 (projet non officiel)",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/vendor-three.js",
    "start": "electron .",
    "dist": "node scripts/vendor-three.js && electron-builder --win zip"
  },
  "build": {
    "appId": "io.github.capglow",
    "productName": "Capglow",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "disableAsarIntegrity": true,
    "artifactName": "Capglow-${version}-windows-x64.${ext}"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "three": "^0.170.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "license": "GPL-3.0-or-later"
}
