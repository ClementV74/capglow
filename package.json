{
  "name": "capglow",
  "productName": "Capglow",
  "version": "0.3.0",
  "description": "Contrôle de l'éclairage RGB des claviers Evoworks EVO80 et Weikav NUT65 (projet non officiel)",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/vendor-three.js",
    "start": "electron .",
    "dist": "node scripts/vendor-three.js && electron-builder --win"
  },
  "build": {
    "appId": "io.github.capglow",
    "productName": "Capglow",
    "files": [
      "main.js",
      "preload.js",
      "installer.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "disableAsarIntegrity": true,
    "artifactName": "Capglow-${version}-windows-x64.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Capglow",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Capglow",
      "artifactName": "Capglow-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "three": "^0.170.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "license": "GPL-3.0-or-later"
}
